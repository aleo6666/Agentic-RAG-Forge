# RAG Forge — Environment Configuration
# Copy to .env and fill in your values.

# Embedding provider: local | siliconflow | openai
RAGFORGE_EMBED_PROVIDER=local
RAGFORGE_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# RAGFORGE_EMBED_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
# RAGFORGE_EMBED_API_KEY=sk-xxx

# LLM provider settings
RAGFORGE_LLM_PROVIDER=deepseek
RAGFORGE_LLM_MODEL=deepseek-chat
RAGFORGE_LLM_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-key-here

# API authentication
RAGFORGE_API_KEY=ragforge-dev-change-me
# RAGFORGE_KEYS=key1:tenant1:admin,key2:tenant2:viewer

# Reranker model
RAGFORGE_RERANKER_MODEL=BAAI/bge-reranker-base
